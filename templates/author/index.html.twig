<h1>Liste des auteurs</h1>

{% if auteurs is defined and auteurs is not empty %}
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for author in auteurs %}
            <tr>
                <td>{{ author.id }}</td>
                <td>{{ author.username }}</td>
                <td>{{ author.email }}</td>
                <td>
                    <a href="{{ path('authorDetails', {'id': author.id}) }}">Details</a> |
                    <a href="{{ path('update_author', {'id': author.id}) }}">Mettre à jour</a> |
                    <a href="{{ path('app_delete', {'id': author.id}) }}">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    <p>Il n'y a aucun auteur.</p>
{% endif %}
