<h1>Liste des auteurs</h1>

{% if authors is defined and authors is not empty %}

    <p><strong>Le nombre total des auteurs est : {{ authors | length }}</strong></p>

    {# Calcul du nombre total de livres #}
    {% set nomberTotal = 0 %}
    {% for author in authors %}
        {% set nomberTotal = nomberTotal + author.nb_books %}
    {% endfor %}
    <p><strong>Le nombre total de livres : {{ nomberTotal }}</strong></p>

    {# Tableau des auteurs #}
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Picture</th>
                <th>Username</th>
                <th>Email</th>
                <th>Number of Books</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            {% for author in authors %}
            <tr>
                <td>{{ author.id }}</td>
                <td>
                    {% if author.picture %}
                        <img src="{{ asset(author.picture) }}" width="80">
                    {% else %}
                        N/A
                    {% endif %}
                </td>
                <td>{{ author.username | upper }}</td>
                <td>{{ author.email }}</td>
                <td>{{ author.nb_books }}</td>
                <td>
                    <a href="{{ path('authorDetails', {'id': author.id}) }}">Details</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

{% else %}
    <p>There is no Data</p>
{% endif %}
