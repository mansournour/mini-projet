<h1>Détails de l'auteur</h1>

{% if author is not null %}
    <p>ID : {{ author.id }}</p>
    <p>Nom : {{ author.username }}</p>
    <p>Email : {{ author.email }}</p>

    <p>
        <a href="{{ path('update_author', {'id': author.id}) }}">Mettre à jour</a>
    </p>

    <p>
        <a href="{{ path('get_author') }}">Retour à la liste</a>
    </p>
{% else %}
    <p>Auteur introuvable.</p>
{% endif %}
